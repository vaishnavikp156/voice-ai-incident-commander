# Agora Project App ID & Certificate (From Agora Console -> Projects)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Agora RESTful API Credentials (From Agora Console -> RESTful API)
AGORA_CUSTOMER_ID=your_customer_id
AGORA_CUSTOMER_SECRET=your_customer_secret

# Channel & Agent Configuration
AGORA_CHANNEL_NAME=incident-pay-2048
AGORA_AGENT_RTC_UID=9999

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional Integrations (Leave empty for graceful unconfigured/demo states)
# Jira Cloud Integration
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=INC

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#incident-room

# PagerDuty Integration (Events API v2)
PAGERDUTY_ROUTING_KEY=your_pagerduty_routing_key
PAGERDUTY_API_KEY=your_pagerduty_api_key

# Monitoring & Observability Integration (Leave empty for DEMO / Simulated Telemetry)
MONITORING_API_KEY=
MONITORING_PROVIDER=Datadog
