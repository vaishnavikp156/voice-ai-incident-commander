# Agora Project App ID & Certificate (From Agora Console -> Projects)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Agora RESTful API Credentials (From Agora Console -> RESTful API)
AGORA_CUSTOMER_ID=your_customer_id
AGORA_CUSTOMER_SECRET=your_customer_secret

# Channel & Agent Configuration
AGORA_CHANNEL_NAME=incident-pay-2048
AGORA_AGENT_RTC_UID=9999

# Server Configuration
HOST=0.0.0.0
PORT=8000
